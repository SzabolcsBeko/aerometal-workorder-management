<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="004-create-workorder-register" author="developer">

        <createTable tableName="workorder_register">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="component_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="access_right_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="workorder_number" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>

            <column name="workorder_date" type="DATE">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Employee relationship -->
        <addForeignKeyConstraint
                baseTableName="workorder_register"
                baseColumnNames="employee_id"
                constraintName="fk_workorder_employee"
                referencedTableName="employee"
                referencedColumnNames="id"/>

        <!-- Component relationship -->
        <addForeignKeyConstraint
                baseTableName="workorder_register"
                baseColumnNames="component_id"
                constraintName="fk_workorder_component"
                referencedTableName="component"
                referencedColumnNames="id"/>

        <!-- Access right relationship -->
        <addForeignKeyConstraint
                baseTableName="workorder_register"
                baseColumnNames="access_right_id"
                constraintName="fk_workorder_access_right"
                referencedTableName="access_right"
                referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>