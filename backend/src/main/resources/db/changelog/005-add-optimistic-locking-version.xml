                        tableName="component"
                        columnName="version"/>
            </not>
        </preConditions>

        <addColumn tableName="component">
            <column
                    name="version"
                    type="BIGINT"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="007-add-version-to-employee" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
